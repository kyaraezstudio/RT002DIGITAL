:root {
  --navy: #13233a;
  --navy-mid: #1e3452;
  --navy-deep: #0c1726;
  --cream: #f6f1e8;
  --cream-deep: #ebe4d6;
  --white: #ffffff;
  --paper: #ffffff;
  --gold: #c4a15a;
  --gold-deep: #a6843d;
  --gold-soft: #f3e6c8;
  --ink: #1a2433;
  --muted: #5c6570;
  --line: color-mix(in oklab, var(--navy) 12%, transparent);
  --wa: #1f7a4d;
  --wa-deep: #17633e;
  --font: "Figtree", "Segoe UI", system-ui, sans-serif;
  --display: "Outfit", "Segoe UI", system-ui, sans-serif;
  --radius-sm: 8px;
  --radius-md: 12px;
  --radius-lg: 20px;
  --radius-xl: 28px;
  --ease: cubic-bezier(0.22, 1, 0.36, 1);
}

.dark {
  --cream: #0c1726;
  --cream-deep: #13233a;
  --paper: #1e3452;
  --ink: #f6f1e8;
  --muted: #b7bdc6;
  --line: color-mix(in oklab, #f6f1e8 12%, transparent);
  --gold-soft: color-mix(in oklab, var(--gold) 22%, #1e3452);
}

*,
*::before,
*::after { box-sizing: border-box; }

html { scroll-behavior: smooth; }

body {
  margin: 0;
  font-family: var(--font);
  background: var(--cream);
  color: var(--ink);
  line-height: 1.5;
}

img, svg { display: block; }
a { color: inherit; text-decoration: none; }
button { font: inherit; color: inherit; background: none; border: 0; cursor: pointer; }

.wrap { width: min(1120px, calc(100% - 32px)); margin-inline: auto; }

.site-header {
  position: fixed;
  inset: 0 0 auto;
  z-index: 40;
  transition: background 0.2s var(--ease), border-color 0.2s var(--ease);
}
.site-header.is-scrolled,
.site-header.is-open {
  background: color-mix(in oklab, var(--cream) 92%, transparent);
  backdrop-filter: blur(12px);
  border-bottom: 1px solid color-mix(in oklab, var(--gold) 45%, var(--line));
}
.header-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 72px;
}
.brand { display: flex; align-items: center; gap: 10px; }
.mark {
  width: 40px; height: 40px; display: grid; place-items: center;
  border-radius: 10px; background: var(--navy); color: var(--white);
  border: 2px solid var(--gold); font-family: var(--display); font-weight: 600; font-size: 14px;
}
.brand-name { font-family: var(--display); font-weight: 600; font-size: 15px; display: block; }
.brand-sub { font-size: 11px; color: var(--muted); }
.nav-desktop { display: none; gap: 4px; }
.nav-desktop a, .nav-mobile a {
  display: block; padding: 8px 12px; border-radius: 8px;
  font-size: 14px; font-weight: 500; color: var(--muted);
}
.nav-desktop a:hover, .nav-mobile a:hover {
  color: var(--ink);
  background: color-mix(in oklab, var(--gold) 18%, transparent);
}
.header-actions { display: flex; gap: 8px; }
.icon-btn {
  width: 44px; height: 44px; display: grid; place-items: center;
  border-radius: 10px; border: 1px solid var(--line); background: var(--paper);
}
.nav-mobile { display: none; padding: 8px 16px 16px; border-top: 1px solid var(--line); }
.nav-mobile.is-open { display: block; }
.menu-btn { display: grid; }

@media (min-width: 768px) {
  .nav-desktop { display: flex; }
  .menu-btn, .nav-mobile { display: none !important; }
}

.hero { padding: 140px 0 64px; }
.hero-grid { display: grid; gap: 48px; align-items: center; }
@media (min-width: 960px) {
  .hero-grid { grid-template-columns: 1fr 1fr; }
}

.eyebrow {
  display: inline-flex; align-items: center; gap: 8px;
  border: 1px solid color-mix(in oklab, var(--gold) 50%, transparent);
  background: var(--paper); border-radius: 999px; padding: 4px 12px;
  font-size: 12px; font-weight: 500; margin-bottom: 16px;
}
.dot { width: 6px; height: 6px; border-radius: 50%; background: var(--gold); }

h1, h2, h3, .display {
  font-family: var(--display); letter-spacing: -0.03em; line-height: 1.15;
}
h1 { font-size: clamp(2rem, 4vw, 3.1rem); font-weight: 600; margin: 0; }
.lede { max-width: 28rem; color: var(--muted); margin: 20px 0 0; }
.actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 32px; }
.btn {
  display: inline-flex; align-items: center; justify-content: center; gap: 8px;
  min-height: 44px; padding: 0 20px; border-radius: 8px; font-size: 14px; font-weight: 600;
}
.btn-primary { background: var(--navy); color: var(--white); box-shadow: inset 0 -2px 0 0 var(--gold); }
.btn-ghost { border: 1px solid color-mix(in oklab, var(--gold) 55%, transparent); background: var(--paper); }

.stats { display: flex; gap: 32px; margin-top: 40px; }
.stats dt { font-size: 11px; text-transform: uppercase; letter-spacing: 0.14em; color: var(--gold-deep); }
.stats dd { margin: 4px 0 0; font-family: var(--display); font-size: 24px; font-weight: 600; }

.panel {
  background: var(--paper);
  border: 1px solid color-mix(in oklab, var(--gold) 40%, var(--line));
  border-radius: var(--radius-xl); padding: 28px;
}
.panel-head { display: flex; align-items: center; gap: 12px; margin-bottom: 20px; }
.badge-02 {
  width: 48px; height: 48px; display: grid; place-items: center; border-radius: 14px;
  background: var(--navy); color: var(--white); border: 2px solid var(--gold);
  font-family: var(--display); font-weight: 600;
}
.person {
  display: flex; align-items: center; gap: 12px; padding: 12px;
  border-radius: 14px; background: var(--cream); margin-top: 12px;
}
.person small { display: block; color: var(--gold-deep); font-size: 11px; }

.section { padding: 80px 0; }
.section-alt { background: color-mix(in oklab, var(--cream-deep) 70%, transparent); }
.section-head { text-align: center; max-width: 36rem; margin: 0 auto 40px; }
.kicker {
  font-size: 12px; font-weight: 500; letter-spacing: 0.16em;
  text-transform: uppercase; color: var(--gold-deep); margin: 0 0 8px;
}
h2 { font-size: clamp(1.75rem, 3vw, 2.25rem); font-weight: 600; margin: 0; }
.section-head p { color: var(--muted); margin: 12px 0 0; }

.cards { display: grid; gap: 16px; }
@media (min-width: 720px) { .cards { grid-template-columns: repeat(3, 1fr); } }
.card {
  text-align: left; background: var(--paper); border: 1px solid var(--line);
  border-radius: var(--radius-lg); padding: 24px; width: 100%;
  transition: transform 0.2s var(--ease), border-color 0.2s var(--ease);
}
.card:hover { transform: translateY(-2px); border-color: color-mix(in oklab, var(--gold) 55%, var(--line)); }
.meta { display: flex; gap: 8px; align-items: center; margin-bottom: 12px; }
.chip { background: var(--gold-soft); color: var(--gold-deep); border-radius: 6px; padding: 4px 8px; font-size: 11px; font-weight: 600; }
.muted { color: var(--muted); font-size: 12px; }
.card h3 { margin: 0; font-size: 18px; font-weight: 600; }
.card p { color: var(--muted); font-size: 14px; margin: 8px 0 16px; }
.more { font-size: 14px; font-weight: 500; color: var(--gold-deep); }

.filters { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; margin-bottom: 28px; }
.filter {
  min-height: 40px; padding: 0 16px; border-radius: 999px; border: 1px solid var(--line);
  background: var(--paper); font-size: 14px; font-weight: 500;
}
.filter.is-on { background: var(--navy); color: var(--white); border-color: transparent; box-shadow: inset 0 -2px 0 0 var(--gold); }

.timeline { max-width: 40rem; margin: 0 auto; display: grid; gap: 12px; }
.event { background: var(--paper); border: 1px solid var(--line); border-radius: var(--radius-lg); padding: 20px; }
.event h3 { margin: 6px 0 4px; font-size: 18px; }
.event p { margin: 0; color: var(--muted); font-size: 14px; }

.pengurus { display: grid; gap: 16px; max-width: 880px; margin: 0 auto; }
@media (min-width: 640px) { .pengurus { grid-template-columns: repeat(3, 1fr); } }
.pengurus article {
  background: var(--paper); border: 1px solid var(--line);
  border-radius: var(--radius-xl); padding: 32px 24px; text-align: center;
}
.avatar {
  width: 64px; height: 64px; margin: 0 auto 16px; display: grid; place-items: center;
  border-radius: 16px; background: var(--navy); color: var(--white); border: 2px solid var(--gold);
  font-family: var(--display); font-size: 20px; font-weight: 600;
}
.pengurus h3 { margin: 0; font-size: 20px; }
.role { margin: 6px 0 0; font-size: 14px; font-weight: 500; color: var(--gold-deep); }
.pengurus p.desc { margin: 12px 0 0; color: var(--muted); font-size: 14px; }

.contact-card { max-width: 32rem; margin: 0 auto; text-align: center; }
.wa-mark {
  width: 56px; height: 56px; margin: 0 auto 16px; display: grid; place-items: center;
  border-radius: 16px; background: var(--wa); color: var(--white);
}
.btn-wa { width: 100%; margin-top: 24px; background: var(--wa); color: var(--white); }
.btn-wa:hover { background: var(--wa-deep); }

.site-footer { border-top: 1px solid var(--line); padding: 32px 0; }
.footer-inner { display: flex; flex-direction: column; gap: 8px; align-items: center; text-align: center; }
@media (min-width: 640px) {
  .footer-inner { flex-direction: row; justify-content: space-between; text-align: left; }
}

.float-wa {
  position: fixed; left: 24px; bottom: 24px; z-index: 50;
  width: 56px; height: 56px; border-radius: 50%;
  background: var(--wa); color: var(--white); display: grid; place-items: center;
  box-shadow: 0 10px 24px color-mix(in oklab, var(--wa) 40%, transparent);
}

.modal {
  position: fixed; inset: 0; z-index: 60;
  background: color-mix(in oklab, var(--navy) 40%, transparent);
  display: none; place-items: center; padding: 16px;
}
.modal.is-open { display: grid; }
.modal-card {
  width: min(32rem, 100%); background: var(--paper);
  border: 1px solid color-mix(in oklab, var(--gold) 40%, var(--line));
  border-radius: 24px; padding: 24px;
}
.modal-top { display: flex; justify-content: space-between; gap: 12px; margin-bottom: 12px; }

@media (prefers-reduced-motion: reduce) {
  html { scroll-behavior: auto; }
  .card { transition: none; }
}
